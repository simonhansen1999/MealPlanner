@page "/"
@using Madplan.Components.Pages.Authentication_pages
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<PageTitle>Madplanlægger</PageTitle>

<div class="hero bg-green-100 p-6 rounded-lg shadow-md text-center mb-6">
    <h1 class="text-3xl font-bold mb-2">Velkommen til Madplanlæggeren!</h1>
    <p class="text-lg text-gray-700">Planlæg dine måltider, organiser dine uger, og gør madlavningen nemmere.</p>
</div>

<AuthorizeView>
    <Authorized>
        <div class="bg-green-50 p-4 rounded-lg shadow-md">
            <h2 class="font-bold text-xl mb-2">Hej, @context.User.Identity!.Name!</h2>
        </div>
    </Authorized>
</AuthorizeView>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <div class="feature bg-white p-4 rounded-lg shadow hover:shadow-lg transition">
        <h2 class="font-semibold text-xl mb-2">Dine madplaner</h2>
        <p>Se og rediger dine måltider for den kommende uge. Find opskrifter og tilføj dine favoritter.</p>
        <a class="text-green-700 font-semibold mt-2 inline-block" href="/personal-week-plan">Gå til din madplan →</a>
    </div>
    <div class="feature bg-white p-4 rounded-lg shadow hover:shadow-lg transition">
        <h2 class="font-semibold text-xl mb-2">Madplaner (delt med dig)</h2>
        <p>Se de madplaner, som er blevet delt med dig.</p>
        <a class="text-green-700 font-semibold mt-2 inline-block" href="/shared-week-plan">Gå til delte madplaner →</a>
    </div>
    <div class="feature bg-white p-4 rounded-lg shadow hover:shadow-lg transition">
        <h2 class="font-semibold text-xl mb-2">Alle madplaner</h2>
        <p>Se og rediger alle ugentlige madplaner (både dine og delte). Find opskrifter og tilføj dine favoritter.</p>
        <a class="text-green-700 font-semibold mt-2 inline-block" href="/week-plan">Gå til alle madplaner →</a>
    </div>
    <AuthorizeView Roles="Admin">
        <div class="feature bg-danger-subtle p-4 rounded-lg shadow hover:shadow-lg transition">
            <h2 class="font-semibold text-xl mb-2">Admin</h2>
            <p>Planlæg eller rediger madplanen, samt de retter, som kan vælges.</p>
            <a class="text-green-700 font-semibold mt-2 inline-block" href="/admin">Gå til Admin →</a>
        </div>
    </AuthorizeView>
</div>

<AuthorizeView>
    <NotAuthorized>
        <br />
        <NotAuthenticated />
        <br />
    </NotAuthorized>
</AuthorizeView>
