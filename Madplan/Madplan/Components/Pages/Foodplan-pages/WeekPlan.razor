@page "/week-plan"
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Madplan.Authentication
@using Madplan.Components.Pages.Authentication_pages
@using Madplan.Components.Pages.Foodplan_pages.Childs
@using Madplan.Models
@using Madplan.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject NavigationManager _navigation
@inject FoodPlanService _foodPlanService
@inject FoodService _foodService
@inject AuthenticationStateProvider _authStateProvider
@inject NavigationState _navState
@inject UserService _userService

<h2 class="mb-4">Ugentlige madplaner</h2>

<AuthorizeView>
    <Authorized>
        <div class="row">
            <h4 class="fw-bold">Dine</h4>
            <Plan />
            <hr />

            <h4 class="fw-bold">Delt med mig</h4>
            <br />
            @if (!_foodPlansShared.Any())
            {
                <div class="col-12">
                    <div class="alert alert-info" role="alert">
                        Der er ikke delt nogen madplaner med dig endnu.
                    </div>
                </div>
            }
            @foreach (var group in _foodPlansShared.GroupBy(x => x.CreatedBy))
            {
                var user = _users.FirstOrDefault(x => x.Id.ToString() == group.Key);

                <h4>Delt af: @(user is not null ? user.Name : "UKENDT")</h4>
                
                <Plan FoodPlans="_foodPlansShared.Where(x => x.CreatedBy.ToString() == group.Key).ToList()" />
                <hr />
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <NotAuthenticated />
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<FoodPlan> _foodPlansPersonal = new List<FoodPlan>();
    private List<FoodPlan> _foodPlansShared = new List<FoodPlan>();
    private List<AppUser> _users { get; set; } = new List<AppUser>();
    private Dictionary<string, Food> _foodMap = new();

    private readonly int _weekNumber = CultureInfo.CurrentCulture.Calendar.GetWeekOfYear(DateTime.Now, CalendarWeekRule.FirstFourDayWeek, DayOfWeek.Monday);
    private readonly string[] _daysOfWeek = GlobalVariables.DaysOfWeek;

    protected override async Task OnInitializedAsync()
    {
        var authState = await _authStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is not null)
        {
            var userId = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.NameIdentifier)?.Value ?? "-";

            _foodPlansPersonal = await _foodPlanService.GetByCreatedBy(userId);
            var email = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value ?? "-";
            _foodPlansShared = await _foodPlanService.GetByEmail(email);
            _users = await _userService.GetAll();

            foreach (var foodPlan in _foodPlansPersonal)
            {
                foreach (var food in foodPlan.Foods)
                {
                    if (!_foodMap.ContainsKey(food.Name))
                    {
                        var foodObj = await _foodService.GetFoodByName(food.Name);
                        if (foodObj is not null)
                        {
                            _foodMap[food.Name] = foodObj;
                        }
                    }
                }
            }
        }
    }

    private void GoToAddFoodPlanPage()
    {
        _navigation.NavigateTo("/foodplan/add");
        _navState.ReturnUrl = _navigation.Uri;
    }

    private void GoToDetails(Guid id)
    {
        _navigation.NavigateTo($"/food/details/{id}");
        _navState.ReturnUrl = _navigation.Uri;
    }

    private void GoToEdit(Guid id)
    {
        _navigation.NavigateTo($"/foodplan/edit/{id}");
        _navState.ReturnUrl = _navigation.Uri;
    }

    private void GoToDetails(Guid id, int multiplier)
    {
        _navigation.NavigateTo($"/food/details/{id}&multiplier={multiplier}");
        _navState.ReturnUrl = _navigation.Uri;
    }
}
