@rendermode InteractiveServer

@using System.Globalization
@using System.Security.Claims
@using Madplan.Models
@using Madplan.Models.Enums
@using Madplan.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject NavigationManager _navigation
@inject FoodPlanService _foodPlanService
@inject FoodService _foodService
@inject AuthenticationStateProvider _authStateProvider
@inject NavigationState _navState

<AuthorizeView>
    <Authorized>

        <!-- WEEK SELECTOR -->
        <div class="sticky-top bg-body border-bottom py-2 mb-3">
            <div class="d-flex align-items-center justify-content-between">

                @if (FoodPlan is null)
                {
                    <!-- Previous week button -->
                    <button class="btn btn-outline-secondary" @onclick="PreviousWeek">
                        <i class="bi bi-chevron-left"></i>
                    </button>

                    <!-- Week dropdown in the center -->
                    <div class="text-center flex-grow-1">
                        <select class="form-select w-auto d-inline-block text-center" @bind="SelectedWeek" @bind:event="onchange">
                            @foreach (var week in Enumerable.Range(1, 52))
                            {
                                <option value="@week" class="@(week == _currentWeek ? "text-success fw-bold" : "")">
                                    Uge @week
                                </option>
                            }
                        </select>

                        <div class="small text-muted mt-1">
                            @_weekStart.ToString("dd/MM-yyyy") – @_weekEnd.ToString("dd/MM-yyyy")
                        </div>

                        @if (_selectedWeek == _currentWeek)
                        {
                            <span class="badge bg-success mt-1">Nuværende uge</span>
                        }
                        else if (_selectedWeek == _currentWeek + 1)
                        {
                            <span class="badge bg-info mt-1">Næste uge</span>
                        }
                    </div>

                    <!-- Next week button -->
                    <button class="btn btn-outline-secondary" @onclick="NextWeek">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                }
            </div>
        </div>

        <!-- WEEK CONTENT -->
        <div class="fade-slide" @key="_selectedWeek">

            @if (SelectedPlan is null)
            {
                <div class="alert alert-info text-center">
                    Ingen madplan for denne uge.
                </div>
            }
            else
            {
                <div class="container-xl mb-4">

                    <div class="card shadow-sm">

                        <!-- CARD HEADER -->
                        <div class="card-header bg-primary text-white d-flex align-items-center">

                            <div class="flex-grow-1 text-center fw-semibold">
                                Madplan
                            </div>

                            <!-- EDIT BUTTON -->
                            <button class="btn btn-sm text-light ms-2" hidden="@HasEditPermission()" title="Rediger" @onclick="() => GoToEdit(SelectedPlan.Id)">
                                <i class="bi bi-pencil"></i>
                            </button>
                        </div>

                        <!-- CARD BODY -->
                        <div class="card-body p-3">

                            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3">
                                @foreach (var day in _daysOfWeek)
                                {
                                    var food = SelectedPlan.Foods.FirstOrDefault(f => f.Day == day);
                                    var isToday = TodayClass(day) == "bg-success-subtle";

                                    <div class="col">
                                        <div class="card h-100 shadow-sm meal-card @(isToday ? "today-card" : "")">
                                            <div class="card-header text-center fw-semibold bg-light">
                                                @day
                                            </div>
                                            <div class="card-body d-flex flex-column">

                                                <!-- Flexible content -->
                                                <div class="flex-grow-1 d-flex flex-column justify-content-center text-center">
                                                    @if (food is null)
                                                    {
                                                        <div class="text-muted fst-italic mt-3 mb-3">
                                                            Ingen plan
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="fw-semibold mb-2 meal-name">@food.Name</div>
                                                    }
                                                </div>

                                                <!-- Button aligned at bottom -->
                                                @if (food is not null && _foodMap.ContainsKey(food.Name))
                                                {
                                                    <button class="btn btn-details w-100 mt-3" @onclick="() => GoToDetails(_foodMap[food.Name].Id, food.NumberOfServings)">
                                                        Se detaljer
                                                        <i class="bi bi-arrow-right ms-1"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>

    </Authorized>
</AuthorizeView>

@code {
    [Parameter]
    public FoodPlan FoodPlan { get; set; } = null!;
    [Parameter]
    public List<FoodPlan> FoodPlans { get; set; } = new();

    private readonly string[] _daysOfWeek = GlobalVariables.DaysOfWeek;
    private readonly int _currentWeek = ISOWeek.GetWeekOfYear(DateTime.Now);
    private readonly string _currentDay = DateTime.Now.ToString("dddd", CultureInfo.GetCultureInfo("da-DK"));

    private int _selectedWeek;
    private int SelectedWeek
    {
        get => _selectedWeek;
        set
        {
            if (_selectedWeek != value)
            {
                _selectedWeek = value;
                UpdateWeekDates();
            }
        }
    }

    private DateTime _weekStart;
    private DateTime _weekEnd;

    private Dictionary<string, Food> _foodMap = new();

    private ClaimsPrincipal? _user;
    private string _userId = "";
    private string _userEmail = "";

    protected override async Task OnInitializedAsync()
    {
        _selectedWeek = _currentWeek;
        UpdateWeekDates();

        var auth = await _authStateProvider.GetAuthenticationStateAsync();
        _user = auth.User;

        if (_user.Identity?.IsAuthenticated == true)
        {
            _userId = _user.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
            _userEmail = _user.FindFirstValue(ClaimTypes.Email) ?? "";

            if (!FoodPlans.Any())
            {
                FoodPlans = await _foodPlanService.GetByCreatedBy(_userId);
            }
        }

        if (FoodPlan is not null)
        {
            _selectedWeek = FoodPlan.WeekNumber;

            FoodPlans = new List<FoodPlan>() { FoodPlan };
        }

        foreach (var plan in FoodPlans)
        {
            foreach (var food in plan.Foods)
            {
                if (!_foodMap.ContainsKey(food.Name))
                {
                    var foodObj = await _foodService.GetFoodByName(food.Name);
                    if (foodObj is not null)
                    {
                        _foodMap[food.Name] = foodObj;
                    }
                }
            }
        }
    }

    private FoodPlan? SelectedPlan => FoodPlans.FirstOrDefault(p => p.WeekNumber == _selectedWeek);

    private void PreviousWeek()
    {
        _selectedWeek--;
        if (_selectedWeek < 1)
        {
            _selectedWeek = 52;
        }
        UpdateWeekDates();
    }

    private void NextWeek()
    {
        _selectedWeek++;
        if (_selectedWeek > 52)
        {
            _selectedWeek = 1;
        }
        UpdateWeekDates();
    }

    private void UpdateWeekDates()
    {
        var year = DateTime.Now.Year;
        _weekStart = ISOWeek.ToDateTime(year, _selectedWeek, DayOfWeek.Monday);
        _weekEnd = _weekStart.AddDays(6);
    }

    private string TodayClass(string day) => day.Equals(_currentDay, StringComparison.OrdinalIgnoreCase) && _selectedWeek == _currentWeek ? "bg-success-subtle" : "";

    private bool HasEditPermission()
    {
        var state = false;

        if (SelectedPlan is not null && _user is not null)
        {
            var isAdmin = _user.IsInRole("Admin");
            var isCreator = SelectedPlan.CreatedBy == _userId;

            var hasDirectEditPermission = SelectedPlan.SharedWith.Any(sw => sw.Email == _userEmail && sw.Permission == SharePermission.Redigering);

            var hasFamilyGroupEditPermission = SelectedPlan.SharedWithFamilyGroups.SelectMany(fg => fg.IndividualPermissions)
                    .Any(p => p.Email == _userEmail && p.SharePermission == SharePermission.Redigering);

            var hasEditPermission = hasDirectEditPermission || hasFamilyGroupEditPermission;

            state = !(isAdmin || isCreator || hasEditPermission);
        }

        return state;
    }

    private void GoToDetails(Guid id, int multiplier)
    {
        _navigation.NavigateTo($"/food/details/{id}&multiplier={multiplier}");
        _navState.ReturnUrl = _navigation.Uri;
    }

    private void GoToEdit(Guid id)
    {
        _navigation.NavigateTo($"/foodplan/edit/{id}");
        _navState.ReturnUrl = _navigation.Uri;
    }
}
